---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import LinkCard from "@components/LinkCard.astro";

const linkGroups = await getCollection("links");
const links = linkGroups.flatMap((group) => group.data).filter((link) => link.visibility === "public");
---

<BaseLayout title="Links" description="外部リンク集。">
  <section class="page-hero">
    <p class="eyebrow">Links</p>
    <h1>外部リンク集</h1>
    <p>初期表示は public のみ。career / private は用途別ページや非公開管理へ回せます。</p>
  </section>
  <section class="card-grid">
    {links.map((link) => <LinkCard {...link} />)}
  </section>
</BaseLayout>
