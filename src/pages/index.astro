---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import WorkCard from "@components/WorkCard.astro";
import profileImage from "../img/sakuragawa.png";

const works = (await getCollection("works"))
  .filter((work) => work.data.visibility === "public")
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const linkGroups = await getCollection("links");
const links = linkGroups.flatMap((group) => group.data).filter((link) => link.visibility === "public");
const linkIconMap: Record<string, string> = {
  code: "bi-github",
  social: "bi-twitter-x",
  blog: "bi-journal-text",
  career: "bi-person-vcard",
};
const heroLinks = links.slice(0, 4).map((link) => ({
  ...link,
  icon: linkIconMap[link.type] ?? "bi-link-45deg",
}));

const skills = [
  ["bi-filetype-py", "Python", "機械学習、データ処理など。困ったときはなんでも押し付けてます"],
  ["bi-braces", "Java", "あまり使わないが一応。大昔にMinecraft Serverの自作plugin作ってました(かなり忘れた)"],
  ["bi-code-slash", "C++", "アルゴリズム系。最近AtCoderやってます！"],
  ["bi-browser-chrome", "Web系", "HTML / CSS / JSそれぞれ。BootStrap愛用していました。"],
  ["bi-box-seam", "Docker", "車免許取得1年目くらいの出来"],
  ["bi-lightning-charge", "Go", "バリバリ学習中。仮免程度。早すぎて見えない。"],
];
---

<BaseLayout title="咲良川 / sakuragawa" description="咲良川の自己紹介、制作物、リンクをまとめたポートフォリオサイト。">
  <section class="hero-section">
    <div class="floating-shapes" aria-hidden="true">
      <span class="shape shape-sakura shape-a"></span>
      <span class="shape shape-sakura shape-b"></span>
      <span class="shape shape-orb shape-c"></span>
      <span class="shape shape-orb shape-d"></span>
      <span class="shape shape-orb shape-e"></span>
      <span class="shape shape-ring shape-f"></span>
      <span class="shape shape-sakura shape-g"></span>
      <span class="shape shape-sakura shape-h"></span>
      <span class="shape shape-sakura shape-i"></span>
    </div>
    <div class="hero-copy">
      <p class="eyebrow">Sakuragawa's Portfolio</p>
      <h1>咲くものを、使える形に。</h1>
      <p>
        楽するためにエンジニアリングする大学生。Webアプリ, それに派生したAPIなど。
        バックエンドそこそこ触ります。IC通信技術に関心アリ。最近はLLMのアーキテクチャの分野に手出し中。
      </p>
      <div class="hero-actions">
        <a class="button primary" href="#works"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i>作品を見る</a>
        <a class="button ghost" href="#profile"><i class="bi bi-person-lines-fill" aria-hidden="true"></i>プロフィール</a>
      </div>
      {heroLinks.length > 0 && (
        <div class="hero-social-links" aria-label="Links">
          {heroLinks.map((link) => (
            <a href={link.url} target="_blank" rel="noreferrer" aria-label={link.name}>
              <i class={`bi ${link.icon}`} aria-hidden="true"></i>
              <span>{link.name}</span>
            </a>
          ))}
        </div>
      )}
    </div>
    <figure class="profile-portrait" aria-label="咲良川のプロフィール画像">
      <img src={profileImage.src} width={profileImage.width} height={profileImage.height} alt="さくらがわのプロフィールイラスト" />
      <figcaption>
        <span>Profile motif</span>
        猫派。ひつまぶしを奢ってくれると喜びます。
      </figcaption>
    </figure>
  </section>

  <div class="page-particles" aria-hidden="true">
    <span class="particle particle-a"></span>
    <span class="particle particle-b"></span>
    <span class="particle particle-c"></span>
    <span class="particle particle-d"></span>
    <span class="particle particle-e"></span>
    <span class="particle particle-f"></span>
    <span class="particle particle-g"></span>
    <span class="particle particle-h"></span>
    <span class="particle particle-i"></span>
    <span class="particle particle-j"></span>
    <span class="particle particle-k"></span>
    <span class="particle particle-l"></span>
    <span class="particle particle-m"></span>
    <span class="particle particle-n"></span>
    <span class="particle particle-o"></span>
    <span class="particle particle-p"></span>
    <span class="particle particle-q"></span>
    <span class="particle particle-r"></span>
    <span class="particle particle-s"></span>
    <span class="particle particle-t"></span>
    <span class="particle particle-u"></span>
    <span class="particle particle-v"></span>
    <span class="particle particle-w"></span>
    <span class="particle particle-x"></span>
    <span class="particle particle-y"></span>
    <span class="particle particle-z"></span>
    <span class="particle particle-aa"></span>
    <span class="particle particle-ab"></span>
    <span class="particle particle-ac"></span>
    <span class="particle particle-ad"></span>
    <span class="particle particle-ae"></span>
    <span class="particle particle-af"></span>
    <span class="particle particle-ag"></span>
    <span class="particle particle-ah"></span>
    <span class="particle particle-ai"></span>
    <span class="particle particle-aj"></span>
    <span class="particle particle-ak"></span>
    <span class="particle particle-al"></span>
    <span class="particle particle-am"></span>
    <span class="particle particle-an"></span>
    <span class="particle particle-ao"></span>
    <span class="particle particle-ap"></span>
    <span class="particle particle-aq"></span>
    <span class="particle particle-ar"></span>
    <span class="particle particle-as"></span>
    <span class="particle particle-at"></span>
    <span class="particle particle-au"></span>
    <span class="particle particle-av"></span>
    <span class="particle particle-aw"></span>
    <span class="particle particle-ax"></span>
    <span class="particle particle-ay"></span>
    <span class="particle particle-az"></span>
    <span class="particle particle-ba"></span>
    <span class="particle particle-bb"></span>
    <span class="particle particle-bc"></span>
    <span class="particle particle-bd"></span>
    <span class="particle particle-be"></span>
    <span class="particle particle-bf"></span>
    <span class="particle particle-bg"></span>
    <span class="particle particle-bh"></span>
    <span class="ambient ambient-orb ambient-a"></span>
    <span class="ambient ambient-orb ambient-b"></span>
    <span class="ambient ambient-ring ambient-c"></span>
    <span class="ambient ambient-ring ambient-d"></span>
    <span class="ambient ambient-triangle ambient-e"></span>
    <span class="ambient ambient-triangle ambient-f"></span>
    <span class="ambient ambient-triangle ambient-g"></span>
    <span class="ambient ambient-triangle ambient-h"></span>
    <span class="ambient ambient-triangle ambient-i"></span>
    <span class="ambient ambient-triangle ambient-j"></span>
  </div>

  <section class="section-band intro-strip" id="profile">
    <div>
      <p class="eyebrow">Profile</p>
      <h2><i class="bi bi-compass section-title-icon" aria-hidden="true"></i>好きなものを、観察・整理し、実装する。</h2>
    </div>
    <div class="intro-copy">
      <section class="personal-profile" aria-label="私的なプロフィール">
        <p class="personal-profile-title"><i class="bi bi-person-heart" aria-hidden="true"></i>私的なプロフィール</p>
        <ul>
          <li><span>資格</span><strong>応用情報技術者 (AP)</strong></li>
          <li><span>趣味</span><strong>猫、旅行、星空</strong></li>
          <li><span>過去</span><strong>過去にはMinecraftやMisskeyに多人数でアクセスするためのサーバーを運営していました。</strong></li>
          <li><span>残したい形</span><strong>自分にも他人にも説明できるWebツール</strong></li>
        </ul>
      </section>
      <div class="profile-statement">
        <p>
          社会システムや既存サービスを観察・分析し、その構造や背景にある設計思想を理解した上で、個人や小規模なコミュニティに適した形へ再設計・応用することをテーマに制作活動を行っています。
        </p>
        <p>
          単に機能を作るだけではなく、「なぜその仕組みが成立しているのか」「どのような制約や運用によって支えられているのか」といった部分まで含めて捉えることを重視しています。
        </p>
      </div>
    </div>
  </section>

  <section class="content-grid two profile-followup">
    <div class="info-panel">
      <p class="eyebrow">Interest</p>
      <h2><i class="bi bi-binoculars section-title-icon" aria-hidden="true"></i>興味分野</h2>
      <ul class="marker-list">
        <li><i class="bi bi-train-front" aria-hidden="true"></i>鉄道データの収集、整形、可視化</li>
        <li><i class="bi bi-clock" aria-hidden="true"></i>時刻・経路・観測を扱う小さな支援ツール</li>
        <li><i class="bi bi-window" aria-hidden="true"></i>Astro を中心にした静的サイト構築</li>
        <li><i class="bi bi-lightning-charge" aria-hidden="true"></i>Bot、自動化、個人用ユーティリティ</li>
      </ul>
    </div>
    <div class="info-panel">
      <p class="eyebrow">Now</p>
      <h2><i class="bi bi-activity section-title-icon" aria-hidden="true"></i>今取り組んでいること</h2>
      <ul class="marker-list">
        <li><i class="bi bi-github" aria-hidden="true"></i>GitHub Pages + Astro のポートフォリオ運用</li>
        <li><i class="bi bi-filetype-py" aria-hidden="true"></i>Python によるデータ取得と可視化</li>
        <li><i class="bi bi-mortarboard" aria-hidden="true"></i>応用情報、語学、情報安全の継続学習</li>
        <li><i class="bi bi-hdd-network" aria-hidden="true"></i>VPS / Linux 環境での小規模サービス運用</li>
      </ul>
    </div>
  </section>

  <section class="section-band" id="works">
    <div class="section-heading">
      <p class="eyebrow">Featured</p>
      <h2><i class="bi bi-kanban section-title-icon" aria-hidden="true"></i>作ったもの</h2>
    </div>
    <div class="work-scroll" aria-label="成果物一覧">
      {works.map((work) => <WorkCard work={work} />)}
    </div>
  </section>

  <section class="section-band" id="skills">
    <div class="section-heading">
      <p class="eyebrow">Skills</p>
      <h2><i class="bi bi-braces-asterisk section-title-icon" aria-hidden="true"></i>取扱スキル</h2>
    </div>
    <div class="skill-panel">
      {skills.map(([icon, name, detail]) => (
        <div class="skill-row">
          <strong><i class={`bi ${icon}`} aria-hidden="true"></i>{name}</strong>
          <span>{detail}</span>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
