---
import { getCollection } from "astro:content";
import BaseLayout from "@layouts/BaseLayout.astro";
import LinkCard from "@components/LinkCard.astro";

const linkGroups = await getCollection("links");
const careerLinks = linkGroups
  .flatMap((group) => group.data)
  .filter((link) => link.visibility === "public" || link.visibility === "career");
---

<BaseLayout title="Career" description="就活・院進向けの活動記録。">
  <section class="page-hero">
    <p class="eyebrow">Career</p>
    <h1>活動記録</h1>
    <p>大学名を前提にせず、制作物、学習、外部プロフィールへの導線を整理します。</p>
  </section>
  <section class="timeline">
    <div>
      <span>Now</span>
      <h2>制作と学習の公開ログ整備</h2>
      <p>作品、技術ブログ、学習記録をGitHub上のMarkdownで継続管理。</p>
    </div>
    <div>
      <span>Next</span>
      <h2>研究・進路向けの実績整理</h2>
      <p>公開範囲を分けたリンクや成果物を段階的に追加。</p>
    </div>
  </section>
  <section class="card-grid">
    {careerLinks.map((link) => <LinkCard {...link} />)}
  </section>
</BaseLayout>
