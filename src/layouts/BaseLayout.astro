---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteName = "3qra introduction";
const {
  title = siteName,
  description = "3qraの自己紹介、制作物、リンクをまとめたポートフォリオサイト。",
} = Astro.props;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6ead8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
    <script is:inline>
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <div class="site-loader" aria-live="polite" aria-label="Loading">
      <div class="loader-mark" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
      </div>
      <p>Loading portfolio</p>
    </div>
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        const easeOutCubic = (t) => 1 - Math.pow(1 - t, 3);
        const scrollToHash = (hash) => {
          const targetElement = document.querySelector(hash);
          if (!targetElement) return false;

          const startY = window.scrollY;
          const targetY = targetElement.getBoundingClientRect().top + window.scrollY - 18;
          const distance = targetY - startY;
          const duration = Math.min(980, Math.max(520, Math.abs(distance) * 0.62));
          const startedAt = performance.now();

          const step = (now) => {
            const progress = Math.min(1, (now - startedAt) / duration);
            window.scrollTo(0, startY + distance * easeOutCubic(progress));
            if (progress < 1) requestAnimationFrame(step);
          };

          requestAnimationFrame(step);
          return true;
        };

        document.addEventListener("click", (event) => {
          const clicked = event.target instanceof Element ? event.target : event.target?.parentElement;
          const link = clicked?.closest("a[href]");
          if (!link) return;

          const url = new URL(link.href);
          if (url.origin !== window.location.origin || !url.hash) {
            return;
          }

          if (url.pathname !== window.location.pathname) {
            sessionStorage.setItem("pending-scroll-hash", url.hash);
            event.preventDefault();
            window.location.href = url.pathname;
            return;
          }

          if (scrollToHash(url.hash)) {
            event.preventDefault();
            history.pushState(null, "", url.hash);
          }
        });

        const pendingHash = sessionStorage.getItem("pending-scroll-hash");
        if (pendingHash) {
          sessionStorage.removeItem("pending-scroll-hash");
          window.setTimeout(() => {
            if (scrollToHash(pendingHash)) history.replaceState(null, "", pendingHash);
          }, 120);
        }

        let current = window.scrollY;
        let target = current;
        let rafId = 0;
        const root = document.documentElement;

        const tick = () => {
          target = window.scrollY;
          current += (target - current) * 0.035;
          const delta = current - target;
          root.style.setProperty("--hero-lag-y", `${delta * 0.24}px`);
          root.style.setProperty("--particle-lag-y", `${delta * 0.42}px`);
          rafId = requestAnimationFrame(tick);
        };

        rafId = requestAnimationFrame(tick);
        window.addEventListener("pagehide", () => cancelAnimationFrame(rafId), { once: true });
      })();
    </script>
    <script is:inline>
      (() => {
        const done = () => {
          window.setTimeout(() => document.documentElement.classList.add("is-loaded"), 260);
        };

        if (document.readyState === "complete") {
          done();
        } else {
          window.addEventListener("load", done, { once: true });
        }

        window.addEventListener("pageshow", () => document.documentElement.classList.add("is-loaded"));
      })();
    </script>
  </body>
</html>
