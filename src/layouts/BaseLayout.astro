---
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import "@styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const siteName = "3qra introduction";
const {
  title = siteName,
  description = "3qraの自己紹介、制作物、リンクをまとめたポートフォリオサイト。",
} = Astro.props;
const pageTitle = title === siteName ? title : `${title} | ${siteName}`;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="UTF-8" />
    <meta name="description" content={description} />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f6ead8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main>
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (() => {
        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        if (reduceMotion) return;

        let current = window.scrollY;
        let target = current;
        let rafId = 0;
        const root = document.documentElement;

        const tick = () => {
          target = window.scrollY;
          current += (target - current) * 0.08;
          const delta = current - target;
          root.style.setProperty("--hero-lag-y", `${delta * 0.08}px`);
          root.style.setProperty("--particle-lag-y", `${delta * 0.16}px`);
          rafId = requestAnimationFrame(tick);
        };

        rafId = requestAnimationFrame(tick);
        window.addEventListener("pagehide", () => cancelAnimationFrame(rafId), { once: true });
      })();
    </script>
  </body>
</html>
