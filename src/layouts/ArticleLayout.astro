---
import BaseLayout from "@layouts/BaseLayout.astro";

interface Props {
  title: string;
  description: string;
  date?: Date;
  tags?: string[];
  links?: { label: string; url: string; icon: string }[];
  backHref?: string;
}

const { title, description, date, tags = [], links = [], backHref = "/" } = Astro.props;
---

<BaseLayout title={title} description={description}>
  <div class="article-particles" aria-hidden="true">
    <span class="particle particle-a"></span>
    <span class="particle particle-b"></span>
    <span class="particle particle-f"></span>
    <span class="particle particle-h"></span>
    <span class="particle particle-n"></span>
    <span class="particle particle-r"></span>
    <span class="particle particle-w"></span>
    <span class="particle particle-af"></span>
    <span class="particle particle-ah"></span>
    <span class="particle particle-av"></span>
    <span class="ambient ambient-orb ambient-a"></span>
    <span class="ambient ambient-ring ambient-c"></span>
    <span class="ambient ambient-triangle ambient-f"></span>
    <span class="ambient ambient-triangle ambient-h"></span>
  </div>
  <article class="article-shell">
    <a class="back-link" href={backHref}>Back</a>
    <header class="article-header">
      {date && <time datetime={date.toISOString()}>{date.toLocaleDateString("ja-JP")}</time>}
      <h1>{title}</h1>
      <p>{description}</p>
      {tags.length > 0 && (
        <div class="tag-row">
          {tags.map((tag) => <span class="tag"><i class="bi bi-hash" aria-hidden="true"></i>{tag}</span>)}
        </div>
      )}
      {links.length > 0 && (
        <div class="article-quick-links" aria-label="外部リンク">
          {links.map((link) => (
            <a class="button ghost" href={link.url} target="_blank" rel="noreferrer">
              <i class={`bi ${link.icon}`} aria-hidden="true"></i>
              {link.label}
            </a>
          ))}
        </div>
      )}
    </header>
    <div class="article-body">
      <slot />
    </div>
  </article>
</BaseLayout>
