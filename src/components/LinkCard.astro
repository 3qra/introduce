---
interface Props {
  name: string;
  url: string;
  type: string;
  identity: "handle" | "real_name" | "anonymous";
  description?: string;
}

const { name, url, type, identity, description } = Astro.props;
---

<a class="link-card card-link" href={url} target="_blank" rel="noreferrer">
  <div class="card-topline">
    <span>{type}</span>
    <span>{identity}</span>
  </div>
  <h3>{name}</h3>
  {description && <p>{description}</p>}
</a>
