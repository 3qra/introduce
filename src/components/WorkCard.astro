---
import type { CollectionEntry } from "astro:content";

interface Props {
  work: CollectionEntry<"works">;
}

const { work } = Astro.props;
const statusLabel = {
  idea: "Idea",
  "in-progress": "In progress",
  released: "Released",
  archived: "Archived",
}[work.data.status];
---

<a class="work-card card-link" href={`/works/${work.slug}`}>
  <div class="card-topline">
    <span><i class="bi bi-folder2-open" aria-hidden="true"></i>{work.data.category}</span>
    <span><i class="bi bi-flag" aria-hidden="true"></i>{statusLabel}</span>
  </div>
  <h3>{work.data.title}</h3>
  <p>{work.data.summary}</p>
  <div class="tag-row">
    {work.data.tags.slice(0, 4).map((tag) => <span class="tag"><i class="bi bi-hash" aria-hidden="true"></i>{tag}</span>)}
  </div>
  <span class="card-cta">
    詳細を見る
    <i class="bi bi-arrow-right" aria-hidden="true"></i>
  </span>
</a>
